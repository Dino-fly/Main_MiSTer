-	dout <= {{8{r4[8]}} | r4[7:0], {8{g4[8]}} | g4[7:0], {8{b4[8]}} | b4[7:0]};
+	dout <= sub4 ? subst
+	             : {{8{r4[8]}} | r4[7:0], {8{g4[8]}} | g4[7:0], {8{b4[8]}} | b4[7:0]};
 	{vs_out,hs_out,de_out} <= vid[11:9];
 end
 
