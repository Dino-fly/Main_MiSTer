{
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "5m",
  "statusLine": {
    "type": "command",
    "command": "$HOME/workspace/Main_MiSTer/.claude/scripts/statusline"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/Main_MiSTer/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/Main_MiSTer/.claude/hooks/guard-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/workspace/Main_MiSTer/.claude/hooks/guard-secrets.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/Main_MiSTer/.claude/hooks/guard-edit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/workspace/Main_MiSTer/.claude/hooks/guard-claims.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "idleCompaction": false
}
