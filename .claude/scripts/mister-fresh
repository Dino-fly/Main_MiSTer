#!/usr/bin/env bash
# mister-fresh - bring the device to a known state before a test, in one call.
#
#   mister-fresh [--restart] [--sys ID [--game TITLE] [--launch]] [--dry-run]
#
# 1. pid shape (exactly one MiSTer with ppid 1; a child of it is the disc helper)
# 2. back to the menu core if a game core is up, and wait for the front-end
# 3. --restart: restart the firmware process ON THE MENU CORE and wait again - the
#    only restart that sets up savestates: a firmware restarted under a running core
#    skips that setup, which is what made every "fresh launch" by hand necessary
# 4. --sys/--game: place the shelf; --launch: start the game and wait for its core
#    (the core is then booted by this firmware, so savestate hooks are armed)
# Prints one verdict line: FRESH OK core=<name> fw=<md5> pids=<shape> [launched in Ns].
# Exit 0 ok, 1 the device did not reach the state, 3 no front-end answer.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
UI="$(dirname "$0")/mister-ui"

RESTART=0; SYS=""; GAME=""; LAUNCH=0; DRY=0
while [ $# -gt 0 ]; do
	case "$1" in
	--restart) RESTART=1 ;;
	--sys) SYS="$2"; shift ;;
	--game) GAME="$2"; shift ;;
	--launch) LAUNCH=1 ;;
	--dry-run) DRY=1 ;;
	-h|--help) sed -n '2,15p' "$0"; exit 0 ;;
	*) die "unknown option $1" 2 ;;
	esac
	shift
done
[ "$LAUNCH" = 0 ] || [ -n "$SYS" ] || die "--launch needs --sys (and usually --game)" 2
need_mister

pid_shape() { mister_ssh 'for p in $(pidof MiSTer); do printf "%s(ppid %s) " "$p" "$(awk "{print \$4}" /proc/$p/stat)"; done; echo' </dev/null | tr -s ' '; }
corename()  { mister_ssh 'cat /tmp/CORENAME 2>/dev/null; true' </dev/null; }
parents()   { grep -o 'ppid 1)' <<<"$1" | wc -l | tr -d ' '; }

if [ "$DRY" = 1 ]; then
	echo "would: pidof shape; load_core menu.rbf if CORENAME != MENU; $( [ $RESTART = 1 ] && echo 'killall MiSTer + setsid ./MiSTer on the menu core;' ) ${SYS:+mister-ui goto $SYS ${GAME:+\"$GAME\"};} $( [ $LAUNCH = 1 ] && echo 'mister-ui launch;' ) verdict line"
	exit 0
fi

SHAPE=$(pid_shape)
[ "$(parents "$SHAPE")" = 1 ] || { echo "FRESH FAIL: firmware process shape ${SHAPE:-none} (need exactly one ppid 1) - restart by hand or mister-deploy"; exit 1; }

if [ "$(corename)" != "MENU" ]; then
	"$UI" menu >/dev/null || { echo "FRESH FAIL: menu core did not come back (pidof MiSTer)"; exit 3; }
fi

if [ "$RESTART" = 1 ]; then
	R='cd /media/fat && killall MiSTer; sleep 1; setsid ./MiSTer >/dev/null 2>&1 </dev/null & exit 0'
	set +e
	ssh "${SSH_OPTS[@]}" "${MISTER_USER}@${MISTER_HOST}" "$R" 2> >(pq_filter >&2) &
	P=$!; for _ in $(seq 1 15); do kill -0 "$P" 2>/dev/null || break; sleep 1; done
	kill "$P" 2>/dev/null; wait "$P" 2>/dev/null
	set -e
	sleep 3
	SHAPE=$(pid_shape)
	[ "$(parents "$SHAPE")" = 1 ] || { echo "FRESH FAIL: after restart shape ${SHAPE:-none}"; exit 1; }
	# the front-end rescans the library before it takes input; mister-ui menu waits for active=1
	"$UI" menu >/dev/null || { echo "FRESH FAIL: front-end not back after restart"; exit 3; }
fi

LAUNCHED=""
if [ -n "$SYS" ]; then
	if [ -n "$GAME" ]; then "$UI" goto "$SYS" "$GAME" >/dev/null; else "$UI" goto "$SYS" >/dev/null; fi
	if [ "$LAUNCH" = 1 ]; then
		t0=$(date +%s)
		OUT=$("$UI" launch) || { echo "FRESH FAIL: $OUT"; exit 1; }
		LAUNCHED=" launched in $(( $(date +%s) - t0 ))s"
	fi
fi
FW=$(mister_ssh "md5sum /media/fat/MiSTer | cut -c1-32" </dev/null)
echo "FRESH OK core=$(corename) fw=$FW pids=$(pid_shape)$LAUNCHED"
