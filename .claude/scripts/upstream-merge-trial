#!/usr/bin/env bash
# upstream-merge-trial - would upstream merge cleanly? Answer without merging anything.
#
#   upstream-merge-trial [--repo DIR] [--target REF]... [--no-fetch] [branch...]
#
# Fetches `origin` (MiSTer-devel, the upstream) and, for each named branch (default:
# classic-ui), reports ahead/behind and the `git merge-tree --write-tree` result against
# each target. Default targets are BOTH candidates for the open decision: upstream
# master's tip and the latest `releases/MiSTer_YYYYMMDD` commit. No checkout, no merge,
# no branch is created; merge-tree writes loose tree objects only.
#
# Exit 0 when every pair merges clean, 1 when any pair conflicts (the files are listed).
set -euo pipefail
. "$(dirname "$0")/lib.sh"

REPO="$MAIN_REPO"; FETCH=1; TARGETS=(); BRANCHES=()
while [ $# -gt 0 ]; do
	case "$1" in
	--repo) REPO="$2"; shift ;;
	--target) TARGETS+=("$2"); shift ;;
	--no-fetch) FETCH=0 ;;
	-h|--help) sed -n '2,13p' "$0"; exit 0 ;;
	-*) die "unknown option $1" 2 ;;
	*) BRANCHES+=("$1") ;;
	esac
	shift
done
[ ${#BRANCHES[@]} -gt 0 ] || BRANCHES=(classic-ui)
g() { git -C "$REPO" "$@"; }
g rev-parse --git-dir >/dev/null 2>&1 || die "$REPO is not a git repository" 2

[ "$FETCH" = 1 ] && g fetch -q origin
if [ ${#TARGETS[@]} = 0 ]; then
	REL=$(g log -1 --format=%H origin/master -- 'releases/MiSTer_*' 2>/dev/null || true)
	TARGETS=(origin/master)
	[ -n "$REL" ] && [ "$REL" != "$(g rev-parse origin/master)" ] && TARGETS+=("$REL")
fi

echo "upstream tip: $(g log -1 --format='%h %cs' origin/master)   latest release: $(g log -1 --format='%h %cs' origin/master -- 'releases/MiSTer_*' 2>/dev/null) $(g show --stat --format= "$(g log -1 --format=%H origin/master -- 'releases/MiSTer_*')" 2>/dev/null | grep -o 'releases/MiSTer_[0-9]*' | head -1)"
rc=0
for b in "${BRANCHES[@]}"; do
	g rev-parse --verify -q "$b" >/dev/null || { echo "$b: no such branch"; rc=1; continue; }
	for t in "${TARGETS[@]}"; do
		read -r behind ahead <<<"$(g rev-list --left-right --count "$t...$b")"
		set +e
		MT=$(g merge-tree --write-tree --name-only "$t" "$b" 2>&1); mrc=$?
		set -e
		case $mrc in
		0) res="CLEAN" ;;
		1) res="CONFLICT: $(echo "$MT" | sed -n '2,/^$/p' | sed '/^$/d' | tr '\n' ' ')"; rc=1 ;;
		*) res="ERROR($mrc): $(echo "$MT" | head -1)"; rc=1 ;;
		esac
		printf '%-12s vs %-14s ahead=%-4s behind=%-4s %s\n' "$b" "$(g rev-parse --short "$t")" "$ahead" "$behind" "$res"
	done
done
[ "$rc" = 0 ] && echo "VERDICT: all clean (nothing merged)" || echo "VERDICT: conflicts or errors above (nothing merged)"
exit "$rc"
